{
  "manifest_version": 3,
  "name": "Pi Browser Connect",
  "version": "0.2.2",
  "description": "Share one browser tab with a local Pi agent. Disconnect at any time.",
  "minimum_chrome_version": "125",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y" } }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Pi Browser Connect"
  }
}
