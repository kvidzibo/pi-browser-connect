{
  "name": "@kvidzibo/pi-browser-connect",
  "version": "0.1.2",
  "description": "Connect Pi to an explicitly shared tab in your everyday Chromium browser.",
  "type": "module",
  "license": "MIT",
  "author": "Tomas Rackauskas",
  "keywords": [
    "pi-package",
    "browser",
    "chromium"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pi-browser-connect.git"
  },
  "homepage": "https://github.com/kvidzibo/pi-browser-connect#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pi-browser-connect/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "bin": {
    "pi-browser-connect": "native-host/install.mjs"
  },
  "files": [
    "index.ts",
    "browser-extension/",
    "native-host/",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/browser.integration.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.20.2",
    "typebox": "1.3.20",
    "typescript": "5.9.3",
    "playwright-core": "^1.56.1"
  }
}
